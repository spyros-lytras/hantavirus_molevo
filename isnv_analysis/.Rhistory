)
rearrange_plot_df<-function(rows_keep_df,seg){
XDHK_df<-rows_keep_df[,c(33,11,13,14,10)]
colnames(XDHK_df) <- c(
"ref.position",
"consensus.base",
"minority.base",
"minority.frequency",
"position.depth"
)
XDHK_df$sample <-'XDHK'
XDHK_df$segment <-seg
XDJH_df<-rows_keep_df[,c(33,24,26,27,23)]
colnames(XDJH_df) <- c(
"ref.position",
"consensus.base",
"minority.base",
"minority.frequency",
"position.depth"
)
XDJH_df$sample <-'XDJH'
XDJH_df$segment <-seg
plot_df<-rbind(XDHK_df,XDJH_df)
return(plot_df)
}
plot_df<-rbind(rearrange_plot_df(rows_keep_S,'S'),
rearrange_plot_df(rows_keep_M,'M'),
rearrange_plot_df(rows_keep_L,'L'))
#codon positions according to reference sequences,
