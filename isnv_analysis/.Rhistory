ref_pos_S<-alignment_to_table('ref_aligned_S.fasta',
"NC_003466.1 Andes virus segment S, complete sequence",
c("PP_006XDHK.5_S","PP_006XDJH.5_S"))
#create positions wise unique identifier to merge datasets
#use XDHK base + XDHK position to merge the basefreq table and the NCBI reference table
ref_pos_S <- ref_pos_S %>%
mutate(
position_XDHK = cumsum(.data[['PP_006XDHK.5_S']] != "-"),
position_XDHK = if_else(.data[['PP_006XDHK.5_S']] == "-",
NA_integer_,
position_XDHK),
unique_XDHK_pos = paste(PP_006XDHK.5_S,position_XDHK,sep='_')
)
merge_S <- merge_S %>%
mutate(
position_XDHK = cumsum(!is.na(PP_consensus.XDHK) & PP_consensus.XDHK != "-"),
position_XDHK = if_else(is.na(PP_consensus.XDHK) | PP_consensus.XDHK == "-",
NA_integer_,
position_XDHK),
unique_XDHK_pos = paste(PP_consensus.XDHK, position_XDHK, sep = "_")
)
merged_S_v2 <- full_join(
merge_S,
ref_pos_S,
by = "unique_XDHK_pos",
suffix = c(".data", ".ref")
)
