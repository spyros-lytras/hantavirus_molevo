#add the NCBI refseq reference (NC_003466.1, NC_003467.2, NC_003468.2) coordinates to the PP_consensuses
#alignment of NCBI RefSeq sequences to PP_006XDHK.5 and PP_006XDJH.5 was generated using
#MAFFT v7.526 with command mafft --retree 2 --reorder ref_S.fasta > ref_aligned_S.fasta
alignment_to_table <- function(aln_file, ref_seq, other_seqs) {
aln <- readDNAStringSet(aln_file)
ref_idx <- match(ref_seq, names(aln))
if (is.na(ref_idx)) {
stop(paste("Reference sequence not found:", ref_seq))
}
ref <- strsplit(as.character(aln[[ref_idx]]), "")[[1]]
pos <- cumsum(ref != "-")
pos[ref == "-"] <- NA
df <- tibble(
position = pos,
!!ref_seq := ref
)
for (s in other_seqs) {
idx <- match(s, names(aln))
if (is.na(idx)) {
stop(paste("Sequence not found:", s))
}
df[[s]] <- strsplit(as.character(aln[[idx]]), "")[[1]]
}
return(df)
}
