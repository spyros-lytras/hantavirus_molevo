library(dplyr)
library(dplyr)
library(ape)
library(Biostrings)
library(ggplot2)
#get basefreq basic table for each segment of each sample,
#the start_pos are identified mannually from sequence content
#the start_pos is basically where the PP_consensus start matching the mapping reference
generate_single_table <- function(filename, seqname, start_pos) {
bf <- read.csv(filename, header = TRUE)
pos_col <- grep("^position\\.in\\.", names(bf), value = TRUE)
if (length(pos_col) != 1) {
stop("Could not uniquely identify the position column.")
}
seq <- readDNAStringSet(seqname)[[1]]
seq_vec <- strsplit(as.character(seq), "")[[1]]
idx <- bf[[pos_col]] - start_pos + 1
valid <- idx >= 1 & idx <= length(seq_vec)
bf$PP_consensus <- NA_character_
bf$PP_consensus[valid] <- seq_vec[idx[valid]]
bf <- bf %>%
rowwise() %>%
mutate(
total.ACGT = sum(c_across(c(A.count, C.count, G.count, T.count))),
majority.base = if (total.ACGT == 0) {
"-"
} else {
c("A", "C", "G", "T")[
which.max(c_across(c(A.count, C.count, G.count, T.count)))
]
},
majority.pct = if (total.ACGT == 0) {
NA_real_
} else {
max(c_across(c(A.count, C.count, G.count, T.count))) /
total.ACGT * 100
},
second.base = if (total.ACGT == 0) {
"-"
} else {
c("A", "C", "G", "T")[
order(
c_across(c(A.count, C.count, G.count, T.count)),
decreasing = TRUE
)[2]
]
},
second.pct = if (total.ACGT == 0) {
NA_real_
} else {
sort(
c_across(c(A.count, C.count, G.count, T.count)),
decreasing = TRUE
)[2] / total.ACGT * 100
},
consensus_matches_majority = case_when(
is.na(PP_consensus) ~ NA,
majority.base == "-" ~ NA,
TRUE ~ PP_consensus == majority.base
)
) %>%
ungroup()
return(bf)
}
bf_S_XDHK<-generate_single_table('XDHK_S_Basefreqs.csv','XDHK_S.fasta',24)
bf_S_XDJH<-generate_single_table('XDJH_S_Basefreqs.csv','XDJH_S.fasta',61)
bf_M_XDHK<-generate_single_table('XDHK_M_Basefreqs.csv','XDHK_M.fasta',51)
bf_M_XDJH<-generate_single_table('XDJH_M_Basefreqs.csv','XDJH_M.fasta',52)
bf_L_XDHK<-generate_single_table('XDHK_L_Basefreqs.csv','XDHK_L.fasta',34)
bf_L_XDJH<-generate_single_table('XDJH_L_Basefreqs.csv','XDJH_L.fasta',76)
#merge the two samples iSNV summary
merge_dfs<-function(key_cols, bf1,bf2){
if (!identical(bf1[key_cols], bf2[key_cols])) {
stop("The first two columns are not identical between the two tables.")
}
merged <- bf1 %>%
left_join(
bf2,
by = key_cols,
suffix = c(".XDHK", ".XDJH") #note this label, the first sample has to be XDHK
) %>%
mutate(
same.majority.base = majority.base.XDHK == majority.base.XDJH,
same.second.base   = second.base.XDHK == second.base.XDJH
)
return(merged)
}
key_cols_S <- c("position.in.MT956618", "base.in.MT956618")
key_cols_M <- c("position.in.MT956619", "base.in.MT956619")
key_cols_L <- c("position.in.MT956620", "base.in.MT956620")
merge_S<-merge_dfs(key_cols_S, bf_S_XDHK,bf_S_XDJH)
#only look at positions where a ACGT consensus was called for both
