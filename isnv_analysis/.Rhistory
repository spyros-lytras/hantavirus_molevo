filter(PP_consensus.XDHK %in% c('A','C','G','T'),
PP_consensus.XDJH %in% c('A','C','G','T'))
merge_M<-merge_dfs(key_cols_M, bf_M_XDHK,bf_M_XDJH)
#only look at positions where a ACGT consensus was called for both
