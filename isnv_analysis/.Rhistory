M = seq(54,3468,3),
L = seq(38,6497,3)
)
plot_df<-plot_df %>%
filter(minority.frequency>=5) %>%
rowwise() %>%
mutate(
codon_position = case_when(
ref.position %in% first_codons_pos[[segment]]  ~ 1L,
ref.position %in% second_codons_pos[[segment]] ~ 2L,
ref.position %in% third_codons_pos[[segment]]  ~ 3L,
TRUE ~ NA_integer_
)
) %>%
ungroup() %>%
mutate(segment = factor(segment,levels = c('S','M','L')),
minority.frequency = round(minority.frequency,digits = 2))
ggplot(plot_df)+
geom_point(aes(x=ref.position,y=minority.frequency,
shape = factor(codon_position),color=sample),size = 2,alpha = 0.75)+
geom_segment(aes(x=ref.position,xend = ref.position,
y=minority.frequency,yend = 0,
alpha = log10(position.depth)),color='navy',linewidth=0.75)+
facet_grid(rows = 'segment')+
scale_y_continuous(limits = c(0,30))+
scale_shape_manual(values = c('1'=17,'2'=15,'3'=1))+
scale_color_discrete(
labels = c("XDHK" = "XDHK:blood",
"XDJH" = "XDJH:nasal")
)+
theme_bw()+
theme(
panel.background = element_rect(fill = "#FFF1E6")
)+
labs(y='Frequency (%)',x='Reference position',
shape='Codon position',color = NULL,
alpha = 'log10(depth)')
ggsave(filename = 'isnv_fig.pdf',plot = get_last_plot(),
width = 10,height = 4,dpi = 300)
write.table(plot_df,file = 'isnv_table.csv',quote = F,row.names = F,sep = ',')
